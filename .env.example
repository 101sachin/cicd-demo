# Copy this file to .env and fill in real values.  NEVER commit .env to git!
#   cp .env.example .env
#
# Supabase dashboard -> Project Settings -> API Keys
#  SUPABASE_URL        = "Project URL"  e.g. https://abcdefgh.supabase.co
#  SUPABASE_SECRET_KEY = a SECRET key (starts with sb_secret_) or the legacy
#                        service_role key. Server-side only - never put it in frontend code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
