<?xml version="1.0"?>
<ruleset name="student-api">
    <description>PSR-12 coding standard - the "lint" stage of the pipeline.</description>
    <file>src</file>
    <file>public</file>
    <file>tests</file>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
        </properties>
    </rule>
</ruleset>
